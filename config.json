name: "PIMA Alarms"
version: "latest"
slug: "pima"
description: "Interface para PIMA Hunter Pro alarms."
url: "https://github.com/carferrer/pima-cfm"
arch:
  - amd64
startup: application
boot: auto
map:
  - config:ro
  - ssl:ro
discovery:
  - mqtt
services:
  - mqtt:want
auto_uart: true
uart: true
environment:
  OPTIONS_FILE: "/data/options.json"
ports:
  7777/tcp: 7777
